# Havemind Compose environment, TEMPLATE ONLY.
#
# Copy to deploy/.env and fill in real values. This file contains NO working
# secrets: the database key is a file secret mounted from /srv/secrets (see
# compose.yaml), never an env value here.
#
# Generate the database key with `havemind generate-db-key` and write it to
# /srv/secrets/havemind_db_key (chmod 0600). Verify the deployment with
# `havemind doctor`, which never prints raw secrets or /srv/secrets contents.

# Public HTTPS URL clients use to reach this server (via tailscale serve).
# Must be HTTPS, no credentials, no query/fragment. REQUIRED, no default.
HAVEMIND_API_BASE_URL=https://havemind.example.ts.net

# Loopback host port to publish (host side stays 127.0.0.1). Optional.
HAVEMIND_PORT=8787

# Image tag for the locally built image. Optional.
HAVEMIND_IMAGE_TAG=0.0.0-private

# Display name shown in the discovery document. Optional.
HAVEMIND_SERVER_NAME=Havemind

# Log level: fatal|error|warn|info|debug|trace|silent. Optional.
HAVEMIND_LOG_LEVEL=info

# --- Scheduled backups -------------------------------------------------------
# Directory INSIDE the container that the backup timer writes to. It is bind
# mounted from ./backups on the host, which must exist and be owned by uid 1000
# before the first `up -d` (see compose.yaml and docs/operations/backup-restore.md).
# Leave EMPTY to switch scheduled backups off. Optional.
HAVEMIND_BACKUP_DIR=/backups

# Backup cadence in whole hours (1..720). Optional, default 24.
HAVEMIND_BACKUP_INTERVAL_HOURS=24

# How many newest artifacts to keep on the host after each run (1..365).
# The off-box restic repository keeps its own 7/4/6 retention. Optional, default 7.
HAVEMIND_BACKUP_KEEP=7
