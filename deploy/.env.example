# Havemind Compose environment — TEMPLATE ONLY.
#
# Copy to deploy/.env and fill in real values. This file contains NO working
# secrets: the database key is a file secret mounted from /srv/secrets (see
# compose.yaml), never an env value here. Strong-secret generation and the
# `havemind doctor` diagnostics are owned by F7-03.

# Public HTTPS URL clients use to reach this server (via tailscale serve).
# Must be HTTPS, no credentials, no query/fragment. REQUIRED — no default.
HAVEMIND_API_BASE_URL=https://havemind.example.ts.net

# Loopback host port to publish (host side stays 127.0.0.1). Optional.
HAVEMIND_PORT=8787

# Image tag for the locally built image. Optional.
HAVEMIND_IMAGE_TAG=0.0.0-private

# Display name shown in the discovery document. Optional.
HAVEMIND_SERVER_NAME=Havemind

# Log level: fatal|error|warn|info|debug|trace|silent. Optional.
HAVEMIND_LOG_LEVEL=info
