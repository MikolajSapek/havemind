# Havemind — CIFS mount of the NAS backup share (SRV-03).
# Install to /etc/systemd/system/mnt-havemind_backup.mount (filename MUST match
# the mount path: /mnt/havemind_backup -> mnt-havemind_backup.mount).
# Pair with mnt-havemind_backup.automount so the share mounts on first access.
[Unit]
Description=Havemind NAS backup share (CIFS)
Requires=network-online.target
After=network-online.target

[Mount]
What=//192.168.254.10/backup
Where=/mnt/havemind_backup
Type=cifs
# credentials file must be root-owned 0600; see smb-credentials.template.
Options=credentials=/srv/secrets/smb-credentials,uid=0,gid=0,file_mode=0600,dir_mode=0700,vers=3.0,nofail,_netdev
TimeoutSec=30

[Install]
WantedBy=multi-user.target
