# Havemind — automount unit for the NAS backup share (SRV-03).
# Install to /etc/systemd/system/mnt-havemind_backup.automount and enable it so
# the CIFS share is mounted on first access (e.g. when a backup script runs).
[Unit]
Description=Automount Havemind NAS backup share

[Automount]
Where=/mnt/havemind_backup
TimeoutIdleSec=600

[Install]
WantedBy=multi-user.target
