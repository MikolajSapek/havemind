# Havemind — Restic environment (SRV-03)
# Sourced by every backup/restore/prune/verify script. No secrets live here:
# the repo password is read from a 0600 file, not stored in this env.
#
# Restic has no native SMB backend, so the encrypted repo lives on a CIFS mount
# of the NAS share //192.168.254.10/backup. The mount point is on the NAS, i.e.
# OFF the server system disk (satisfies SRV-03 "repo poza dyskiem systemowym").

# CIFS mount point for the NAS share (see systemd/ + fstab.snippet).
export NAS_MOUNT="/mnt/havemind_backup"

# Restic repository = subdirectory on the NAS mount.
export RESTIC_REPOSITORY="${NAS_MOUNT}/havemind-restic"

# Repo password file. Final home is /srv/secrets (root-owned, 0600).
# During pre-sudo preparation it lives in ~/havemind-ops/secrets/ — override
# RESTIC_PASSWORD_FILE before the move if you test as the mikolaj user.
export RESTIC_PASSWORD_FILE="${RESTIC_PASSWORD_FILE:-/srv/secrets/restic-repo-password}"

# What we back up: the Havemind application data directory (SQLite + blob store).
export HAVEMIND_APPDATA="/srv/appdata/havemind"

# Retention policy (SRV-03): 7 daily / 4 weekly / 6 monthly.
export KEEP_DAILY=7
export KEEP_WEEKLY=4
export KEEP_MONTHLY=6

# Tag + host applied to every snapshot so retention/verify scope is unambiguous.
export RESTIC_TAG="havemind"
export RESTIC_HOST="sapserver"
