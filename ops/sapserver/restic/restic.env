# Havemind — Restic environment (SRV-03), SFTP backend to the owner's Mac.
#
# Sourced by every backup/restore/prune/verify/drill script. No secrets live
# here: the repo password is read from a 0600 file and the SSH private key stays
# in ~/.ssh. Neither is stored in this env or in the repo.
#
# Design (sudo-free end to end):
#   * The Havemind server writes its own backup artifacts on a timer into the
#     HOST bind mount below (HAVEMIND_BACKUP_DIR=/backups inside the container →
#     ~/havemind/deploy/backups on sapserver). The operator account needs NO
#     docker group and NO sudo, because it only reads finished files.
#   * Restic ships those files to the owner's Mac over the tailnet using its
#     native SFTP backend (plain ssh — no rclone, no SMB, no kernel mount).
#   * The repository is encrypted by restic itself, so the artifacts are
#     protected at rest on the Mac.
#   * Data never leaves hardware the owner owns: sapserver → tailnet → Mac.

# Static binaries installed under ~/bin (no sudo). Ensure they win on PATH even
# in non-login shells (cron) where ~/bin may be absent.
export PATH="${HOME}/bin:${PATH}"

# --- destination: the owner's Mac over the tailnet ---------------------------
# MAC_SSH_ALIAS is an entry in ~/.ssh/config (0600) that pins the real tailnet
# hostname, the macOS username and the dedicated key. Keeping it in ssh_config
# means restic, the preflight probe and any manual `ssh`/`sftp` all agree, and no
# hostname or username is duplicated across these scripts:
#
#   Host havemind-backup
#     HostName <mac-tailscale-name>       # e.g. mikolajs-mbp.tailnet-xxxx.ts.net
#     User <mac-username>
#     IdentityFile ~/.ssh/id_ed25519_havemind_backup
#     IdentitiesOnly yes
#     ServerAliveInterval 15
#
export MAC_SSH_ALIAS="${MAC_SSH_ALIAS:-havemind-backup}"

# Repository directory on the Mac, relative to the login home directory.
export MAC_REPO_PATH="${MAC_REPO_PATH:-havemind-restic}"

# Restic repository via the native SFTP backend.
export RESTIC_REPOSITORY="sftp:${MAC_SSH_ALIAS}:${MAC_REPO_PATH}"

# --- secrets -----------------------------------------------------------------
# Repo encryption password (0600). Losing BOTH this file and its copy in the
# owner recovery kit makes every snapshot unrecoverable — restic has no backdoor.
export RESTIC_PASSWORD_FILE="${RESTIC_PASSWORD_FILE:-${HOME}/havemind-ops/secrets/restic-repo-password}"

# --- what we back up ---------------------------------------------------------
# The HOST side of the compose bind mount `./backups:/backups`, which Docker
# resolves relative to the COMPOSE FILE's directory. Driving the stack from the
# repo checkout (`cd ~/havemind && docker compose -f deploy/compose.yaml up -d`)
# puts it exactly where the default below points. If the stack is driven from a
# compose.yaml copied elsewhere, export HAVEMIND_BACKUP_SOURCE accordingly.
#
# Every entry is a
# self-contained artifact directory: one `manifest.json` pinning the SHA-256 and
# size of every blob, one `havemind.db` snapshot and the blobs themselves.
#
# This is deliberately NOT the live data volume: a hot copy of a WAL-mode SQLite
# file is not a consistent backup, whereas each artifact was written through
# SQLite's online backup API.
export HAVEMIND_BACKUP_SOURCE="${HAVEMIND_BACKUP_SOURCE:-${HOME}/havemind/deploy/backups}"

# --- retention (SRV-03): 7 daily / 4 weekly / 6 monthly ----------------------
export KEEP_DAILY=7
export KEEP_WEEKLY=4
export KEEP_MONTHLY=6

# Tag + host applied to every snapshot so retention/verify scope is unambiguous.
export RESTIC_TAG="havemind"
export RESTIC_HOST="sapserver"

# Timestamped log line on stdout; cron mails it, `logger` is not required.
log() {
  printf '%s [havemind-backup] %s\n' "$(date -Is)" "$*"
}

# Preflight: can we open an SSH session to the Mac right now? BatchMode keeps it
# non-interactive (never prompts in cron), ConnectTimeout bounds a sleeping or
# absent peer. Returns 0 when reachable.
#
# A laptop that is asleep, closed or off the tailnet is the NORMAL case, not an
# error: cron-driven scripts log a skip and exit 0 so the operator's mailbox
# stays quiet and no false alarm hides a real failure.
mac_reachable() {
  ssh -o BatchMode=yes -o ConnectTimeout=8 "${MAC_SSH_ALIAS}" true 2>/dev/null
}

# Guard against the failure mode that made the previous design useless: pointing
# restic at a directory that holds no artifacts, and reporting success. An
# artifact is identified by its manifest.
source_has_artifact() {
  [ -d "${HAVEMIND_BACKUP_SOURCE}" ] &&
    find "${HAVEMIND_BACKUP_SOURCE}" -maxdepth 2 -name manifest.json -print -quit |
    grep -q .
}
