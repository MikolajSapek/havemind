# Havemind — Restic environment (SRV-03), rclone SMB backend (sudo-free).
# Sourced by every backup/restore/prune/verify script. No secrets live here:
# the repo password is read from a 0600 file, and the SMB password lives only in
# rclone.conf (0600). Neither is stored in this env or in the repo.
#
# Restic has no native SMB backend, so we use its `rclone:` backend. rclone
# speaks SMB in userspace (no CIFS kernel mount, no sudo, no apt). The encrypted
# repo therefore lives on the NAS SMB share, off the server system disk
# (satisfies SRV-03 "repo poza dyskiem systemowym").

# Static binaries installed under ~/bin (no sudo). Ensure they win on PATH even
# in non-login shells (systemd, cron) where ~/bin may be absent.
export PATH="${HOME}/bin:${PATH}"

# --- rclone SMB target -------------------------------------------------------
# The rclone remote is defined in ~/.config/rclone/rclone.conf (0600). SMB has
# no "share" config key: the share is the FIRST path element after the remote.
# Share on the NAS is `backup`, so the repo path is backup/havemind-restic.
export RCLONE_REMOTE="nas-backup"
export RCLONE_SHARE="backup"
export NAS_HOST="192.168.254.10"
export SMB_PORT="445"

# Restic repository via the rclone backend.
export RESTIC_REPOSITORY="rclone:${RCLONE_REMOTE}:${RCLONE_SHARE}/havemind-restic"

# --- secrets -----------------------------------------------------------------
# Repo encryption password (0600). Sudo-free home: ~/havemind-ops/secrets.
export RESTIC_PASSWORD_FILE="${RESTIC_PASSWORD_FILE:-${HOME}/havemind-ops/secrets/restic-repo-password}"

# --- what we back up ---------------------------------------------------------
# The Havemind application data directory (SQLite + blob store) is expected at
# /srv/appdata/havemind, but that path is root-owned and unavailable to the
# sudo-free pilot. Until the app writes to a user-readable location, back up the
# staging directory. Override HAVEMIND_APPDATA to point at the real appdata once
# it is readable by this user.
export HAVEMIND_APPDATA="${HAVEMIND_APPDATA:-${HOME}/havemind-ops/staging}"

# --- retention (SRV-03): 7 daily / 4 weekly / 6 monthly ----------------------
export KEEP_DAILY=7
export KEEP_WEEKLY=4
export KEEP_MONTHLY=6

# Tag + host applied to every snapshot so retention/verify scope is unambiguous.
export RESTIC_TAG="havemind"
export RESTIC_HOST="sapserver"

# Preflight: is the NAS SMB port reachable? Returns 0 if reachable. Uses bash
# /dev/tcp so it needs no extra tooling. Callers abort with a clear message.
nas_reachable() {
  timeout 3 bash -c ">/dev/tcp/${NAS_HOST}/${SMB_PORT}" 2>/dev/null
}
