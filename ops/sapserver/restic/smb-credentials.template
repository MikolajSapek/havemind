# Havemind — CIFS credentials for the NAS share //192.168.254.10/backup
#
# The agent does NOT know these values. Fill them in, then this file becomes the
# `credentials=` source for the CIFS mount. Keep it 0600 and root-owned once in
# /srv/secrets. Do NOT commit the filled-in file to any repo.
#
# username = the NAS account allowed to write the `backup` share
# password = that account's password
# domain   = NAS workgroup/domain (often WORKGROUP; delete the line if unused)
username=CHANGE_ME
password=CHANGE_ME
domain=WORKGROUP
