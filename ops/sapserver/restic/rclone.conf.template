# Havemind — rclone remote for the NAS SMB share (SRV-03).
#
# Real home on sapserver: ~/.config/rclone/rclone.conf (chmod 0600). This file
# is only a TEMPLATE — the agent does NOT know the SMB credentials, so `user`
# and `pass` are placeholders. Fill them in and NEVER commit the filled copy.
#
# `pass` MUST be an rclone-obscured value, not the plaintext password. Generate
# it on sapserver (the plaintext is only piped, never stored):
#     ~/bin/rclone obscure 'THE_SMB_PASSWORD'
# then paste the output as the `pass =` value. Or configure interactively with
#     ~/bin/rclone config
# which obscures the password for you and writes this same file.
#
# SMB has no "share" key here: the share (`backup`) is the first path element in
# the restic repository string — see restic.env (RESTIC_REPOSITORY).

[nas-backup]
type = smb
host = 192.168.254.10
user = CHANGE_ME
pass = CHANGE_ME_OBSCURED
